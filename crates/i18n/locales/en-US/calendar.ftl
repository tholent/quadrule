calendar-day-wed-short = Wed
calendar-day-thu-short = Thu
calendar-day-fri-short = Fri
calendar-day-sat-short = Sat
calendar-day-sun-short = Sun
calendar-day-mon-letter = M
calendar-day-tue-letter = T
calendar-day-wed-letter = W
calendar-day-thu-letter = T
calendar-day-fri-letter = F
