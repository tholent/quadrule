// Supernote Nomad (A6 X2). Resolution and PPI: napkin §3.3 (napkins/quadrule-spec.md:100).
// Everything marked ESTIMATE is a placeholder until maintainer calibration on hardware
// (napkin §8.4); calibration replaces these values here, with no code change.
(
    id: "supernote.a6x2",
    display_name: "Supernote Nomad (A6 X2)",
    short_name: "nomad",
    width_px: 1404,
    height_px: 1872,
    ppi: 300.0,
    diagonal_in: 7.8,
    panel: "to verify",
    // Measured 2026-11-12 on the grays sheet (chris; docs/device-measurements/supernote.a6x2/calibration.md):
    // all 16 even steps are clean (flat, no speckle), and so are the grays between them. On a flat area 0-68 all
    // look black and 238-255 white (229 already does); the middle 85-221 are 9 distinct grays, each between-step
    // gray looking like one of its neighbours.
    // ADR-027 (2026-11-26): every gray below sits on the pen-gray scale, moved from the old step in its place (0 → 1,
    // 51 → 53, 153 → 157, 204 → 201 …); the codes in the comments are chris's readings on the old steps.
    gray_levels: [1, 18, 36, 53, 70, 88, 105, 122, 140, 157, 172, 186, 201, 219, 237, 255],
    // Measured 2026-11-09 from docs/device-measurements/supernote.a6x2/nomad-pen-shades.png (chris):
    // the gray each pen color writes, black, dark grey, light grey, white. Checked by
    // crates/xtask/tests/pen_shades.rs.
    ink_values: [1, 157, 201, 254],
    // Measured 2026-11-09 by `cargo xtask safe-zones` from the portrait screenshots in
    // docs/device-measurements/supernote.a6x2/ (toolbar docked left, right, top, and floating at its
    // default place). Footer zones are covered in every screenshot: page navigation (left) and
    // note name (right). Docked toolbars span their whole edge (their length depends on the
    // icons chosen); only thickness is measured. Not yet measured: landscape, collapsed toolbar.
    safe_zones: [
        (name: "footer_left", orientation: Portrait, rect: (110, 1772, 325, 100), advisory: false),
        (name: "footer_right", orientation: Portrait, rect: (948, 1772, 346, 100), advisory: false),
        (name: "toolbar_floating_default", orientation: Portrait, rect: (534, 119, 100, 1245), advisory: true),
        (name: "toolbar_left", orientation: Portrait, rect: (0, 0, 99, 1872), advisory: false),
        (name: "toolbar_right", orientation: Portrait, rect: (1305, 0, 99, 1872), advisory: false),
        (name: "toolbar_top", orientation: Portrait, rect: (0, 0, 1404, 99), advisory: false),
    ],
    // ESTIMATE.
    default_margins_mm: (top: 6.0, right: 6.0, bottom: 6.0, left: 6.0),
    // Landscape (rung 8b): a landscape design is exported turned a quarter turn clockwise into the portrait
    // template (docs/device-measurements/supernote.a6x2/landscape-test.md), so the portrait zones above apply.
    orientations: [Portrait, Landscape],
    // Calibrated 2026-11-09 by chris on the device, from the calibration sheets; codes and
    // rulings in docs/device-measurements/supernote.a6x2/calibration.md. Widths in device
    // pixels, grays 0 = black .. 255 = white.
    line_roles: (
        whisper: (width_px: 1, gray: 122),    // LA8
        guide: (width_px: 1, gray: 53),       // LA4, W1: the favourite line
        structure: (width_px: 2, gray: 53),   // LB4
        emphasis: (width_px: 3, gray: 1),     // LC1
        dot_grid: (width_px: 3, gray: 53),    // W15, square: 2 px dots show but are not usable
        text_gray: 53,                        // TD2, TL2 (9 pt reads comfortably)
        label_gray: 157,                      // TD4, TL4
        margin: (width_px: 5, gray: 201),     // ADR-020: chris's drawn values, chosen, not measured
    ),
    // The gray each fill role resolves to (rung 6 bbq, Q3 and Q7), from the grays sheet, 2026-11-12 (chris): Block
    // 68 looked black, so it moved to "A lighter dark gray" (102, G7); Shade 204 (G13) is clean and visible, kept.
    fill_roles: (
        shade: 201,
        block: 105,
    ),
    // What the linter judges a page against (rung 14 bbq, Q2 to Q4, 2026-11-17), from the Nomad sheets. Grays are
    // 0 = black .. 255 = white; "lightest" is the lightest gray that still shows, so anything lighter is flagged (L03).
    // Sheet codes are in docs/device-measurements/supernote.a6x2/calibration.md. An empty (left out) value means the
    // rule is skipped on this profile.
    lint: (
        lightest_gray_line_1px: Some(186),      // 1 px lines: LA12 is the last visible (lines sheet)
        lightest_gray_line_2px_up: Some(201),   // 2 px and wider: LB13 to LF13 are the last visible; 221 and 238 vanish
        lightest_gray_dot_2px: Some(105),       // square 2 px dots: PB3 (dots sheet)
        lightest_gray_dot_3px: Some(172),       // square 3 px dots: PC5
        lightest_gray_dot_4px_up: Some(186),    // square 4 px dots and larger: PD6
        lightest_gray_fill: Some(201),          // fills: Shade 204 (G13, grays sheet) shows
        lightest_gray_text: Some(157),          // text: 153 (TD4, TL4) is the lightest tested
        smallest_text_pt: Some(6.0),            // 6 pt is the smallest tested; every sample was legible (TA3, TI3)
        // Not measured (rung 14 bbq, Q4); retune here without code.
        smallest_handwriting_step_mm: Some(5.0), // Supernote's own grid is 5 mm
        dark_fill_gray: Some(105),              // the Block fill role (G7)
        dark_fill_page_share: Some(0.1),
        thin_line_px: Some(2),
    ),
    calibration_meta: (
        date: Some("2026-11-09"),
        firmware: None,
        method: "Calibration sheets (cargo xtask calibration-sheet) judged by eye on the device by chris; docs/device-measurements/supernote.a6x2/calibration.md. Gray levels measured on the grays sheet 2026-11-12; ink values are not measured yet.",
        verified: true,
    ),
    // Napkin §11.3.
    export_hints: ["Copy templates to the MyStyle folder; a subfolder appears under Customization."],
)
