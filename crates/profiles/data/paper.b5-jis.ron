// JIS B5, a paper size (napkin §3.3.1; rung 13 record docs/bbq/2026-11-17-rung-13-profile-system.md, Q12 to Q14).
// A paper profile is a physical size, not a screen: `paper` is the size in mm, and `width_px` and `height_px` are
// that size at 300 PPI, the default. A page picks its export PPI (150, 200, 300 or 600) and the pixel size and the
// line widths below follow it: a width is scaled by PPI / 300, rounded to whole pixels, at least 1.
// The role values are the Nomad's (docs/device-measurements/supernote.a6x2/calibration.md) taken by physical size,
// not measured on paper, so the profile is Unverified. No safe zones, no gray levels, no pen grays (napkin §3.3.1).
(
    id: "paper.b5-jis",
    display_name: "JIS B5",
    short_name: "b5-jis",
    width_px: 2150,
    height_px: 3035,
    ppi: 300.0,
    paper: Some((width_mm: 182.0, height_mm: 257.0)),
    diagonal_in: 12.4,
    panel: "paper",
    // ADR-027 (2026-11-26): every gray below sits on the pen-gray scale, moved from the old step in its place (0 → 1,
    // 51 → 53, 153 → 157, 204 → 201 …); the codes in the comments are chris's readings on the old steps.
    gray_levels: [],
    ink_values: [],
    safe_zones: [],
    default_margins_mm: (top: 10.0, right: 10.0, bottom: 10.0, left: 10.0),
    orientations: [Portrait, Landscape],
    line_roles: (
        whisper: (width_px: 1, gray: 122),
        guide: (width_px: 1, gray: 53),
        structure: (width_px: 2, gray: 53),
        emphasis: (width_px: 3, gray: 1),
        dot_grid: (width_px: 3, gray: 53),
        text_gray: 53,
        label_gray: 157,
        margin: (width_px: 5, gray: 201),
    ),
    fill_roles: (
        shade: 201,
        block: 105,
    ),
    // Paper carries only the values that need no screen (rung 14 bbq, Defaulted "Paper profiles' lint blocks"): the
    // smallest text size (the Nomad's, 6 pt) and the smallest handwriting step (5 mm).
    lint: (
        smallest_text_pt: Some(6.0),
        smallest_handwriting_step_mm: Some(5.0),
    ),
    calibration_meta: (
        date: None,
        firmware: None,
        method: "The Nomad's role values by physical size (rung 13 record, Q13); not measured on paper.",
        verified: false,
    ),
    export_hints: [],
)
